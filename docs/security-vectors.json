  "revoke": {
    "_comment": "buildRevoke emits approve(spender, 0) calldata EXACTLY, via the existing chains/evm.js erc20ApproveData; the suite never signs — this tx goes through the normal sign path + agent gate.",
    "chain": "ethereum",
    "token": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
    "spender": "0x1111111111111111111111111111111111111111",
