  },
  "gateComposition": {
    "_comment": "A danger inspection forces a human confirm even when the action is within allocation / under autoApproveUnderUsd. This composes with (never weakens) the existing policy gate: forceConfirm only ever removes the auto-approve/skip shortcuts, it can never grant approval on its own.",
    "scenario": { "autoApproveUnderUsd": 100, "actionUsd": 1, "inspectionSeverity": "danger" },
    "expect": {
      "withoutSecurity": { "approved": true, "auto": true },
      "withDangerForceConfirm": { "auto": false, "humanConfirmCalled": true },
      "withDangerForceConfirm_declined": { "approved": false }
    }
  }
