        "version": 2,
        "relayProtocol": "irn",
        "symKey": "aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899"
      }
    },
    "rejectV1": {
      "uri": "wc:8a1b2c3d@1?bridge=https%3A%2F%2Fbridge.walletconnect.org&key=deadbeef",
