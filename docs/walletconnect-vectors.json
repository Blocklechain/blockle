    "rejectMalformed": [
      { "uri": "https://not-walletconnect.example/foo", "expectErrorMatch": "wc:" },
      { "uri": "wc:abc123", "expectErrorMatch": "@version" },
      { "uri": "wc:abc123@2?relay-protocol=irn", "expectErrorMatch": "symKey" },
      { "uri": "wc:abc123@2?symKey=aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899", "expectErrorMatch": "relay-protocol" },
      { "uri": "wc:nothex@2?relay-protocol=irn&symKey=aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899", "expectErrorMatch": "topic" }
    ]
