  "inspect": {
    "_comment": "A built ERC-721 send, inspected by security.inspectTransaction, decodes to kind nft-transfer with the recipient; a recipient on the denylist raises send-to-flagged (danger). Proves the send routes through the SAME security gate as a normal send.",
    "safeRecipient": {
      "tx": {
        "chain": "ethereum",
        "to": "0xBc4CA0EdA7647A8aB7C2061c2E118A18a936f13D",
        "data": "0x42842e0e0000000000000000000000001111111111111111111111111111111111111111000000000000000000000000222222222222222222222222222222222222222200000000000000000000000000000000000000000000000000000000000004d2"
      },
      "expect": { "kind": "nft-transfer", "severity": "none", "to": "0x2222222222222222222222222222222222222222", "tokenId": "1234" }
    },
    "flaggedRecipient": {
      "tx": {
        "chain": "ethereum",
        "to": "0xBc4CA0EdA7647A8aB7C2061c2E118A18a936f13D",
        "data": "0x42842e0e0000000000000000000000001111111111111111111111111111111111111111000000000000000000000000deadbeefdeadbeefdeadbeefdeadbeefdeadbeef00000000000000000000000000000000000000000000000000000000000004d2"
