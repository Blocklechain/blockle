  "guards": [
    {
      "name": "erc1155 overdraw refused (amount > owned balance, fail-closed)",
      "ctx": { "accounts": [{ "chain": "ethereum", "address": "0x1111111111111111111111111111111111111111" }] },
      "req": {
        "chain": "ethereum",
        "standard": "erc1155",
        "contract": "0x495f947276749Ce646f68AC8c248420045cb7b5e",
        "tokenId": "42",
        "amount": "9",
        "ownedBalance": "7",
        "from": "0x1111111111111111111111111111111111111111",
        "to": "0x2222222222222222222222222222222222222222"
      },
      "expectError": "exceeds owned balance"
    },
    {
      "name": "wrong-from refused (from != this wallet's address, fail-closed)",
      "ctx": { "accounts": [{ "chain": "ethereum", "address": "0x1111111111111111111111111111111111111111" }] },
      "req": {
        "chain": "ethereum",
        "standard": "erc721",
        "contract": "0xBc4CA0EdA7647A8aB7C2061c2E118A18a936f13D",
        "tokenId": "1234",
        "from": "0x9999999999999999999999999999999999999999",
        "to": "0x2222222222222222222222222222222222222222"
      },
      "expectError": "not this wallet"
    },
    {
      "name": "erc1155 missing ownedBalance refused (cannot guard overdraw, fail-closed)",
      "ctx": { "accounts": [{ "chain": "ethereum", "address": "0x1111111111111111111111111111111111111111" }] },
      "req": {
        "chain": "ethereum",
        "standard": "erc1155",
        "contract": "0x495f947276749Ce646f68AC8c248420045cb7b5e",
        "tokenId": "42",
        "amount": "1",
