  "approvals": {
    "_comment": "surfaceApprovals reuses Security.listApprovals (read-only). An operator row (setApprovalForAll) is surfaced as danger/revocable; a sized ERC-20 allowance is not an operator approval. No new approval path — revocation goes through the normal send flow + security gate.",
    "chain": "ethereum",
    "owner": "0x1111111111111111111111111111111111111111",
    "rawApprovals": [
      {
        "token": "0xBc4CA0EdA7647A8aB7C2061c2E118A18a936f13D",
        "tokenSymbol": "BAYC",
        "spender": "0x00000000006c3852cbEf3e08E8dF289169EdE581",
        "spenderLabel": "OpenSea Seaport",
        "operator": true
      },
      {
        "token": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
