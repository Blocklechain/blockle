          "collection": "0xBc4CA0EdA7647A8aB7C2061c2E118A18a936f13D",
          "operator": "0x00000000006c3852cbEf3e08E8dF289169EdE581",
          "severity": "danger",
          "revocable": true
        }
      ]
    }
