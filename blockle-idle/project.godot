; Blockle Idle — isometric pixel-art idle game.
; Engine configuration. Rendering is PIXEL-PERFECT by construction: the game
; renders at a small internal resolution (360x640) and the viewport is scaled up
; with integer nearest-neighbour, so every pixel is a real, chunky pixel.

config_version=5

[application]

config/name="Blockle Idle"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.055, 0.065, 0.11, 1)
boot_splash/show_image=false

[autoload]

Pal="*res://scripts/Pal.gd"
Iso="*res://scripts/Iso.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.11, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
