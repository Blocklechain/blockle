; Engine configuration file.
; Blockle Idle — portrait idle civilization game (Godot 4.7).

config_version=5

[application]

config/name="Blockle Idle"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/show_image=false

[autoload]

GameData="*res://scripts/autoload/GameData.gd"
WorldGen="*res://scripts/autoload/WorldGen.gd"
Traits="*res://scripts/autoload/Traits.gd"
Save="*res://scripts/autoload/Save.gd"
Game="*res://scripts/autoload/Game.gd"
Economy="*res://scripts/autoload/Economy.gd"
Production="*res://scripts/autoload/Production.gd"
Buildings="*res://scripts/autoload/Buildings.gd"
Blocklings="*res://scripts/autoload/Blocklings.gd"
Research="*res://scripts/autoload/Research.gd"
Realms="*res://scripts/autoload/Realms.gd"
Ascension="*res://scripts/autoload/Ascension.gd"
Offline="*res://scripts/autoload/Offline.gd"
Audio="*res://scripts/autoload/Audio.gd"
Achievements="*res://scripts/autoload/Achievements.gd"
Cosmetics="*res://scripts/autoload/Cosmetics.gd"
IAP="*res://scripts/autoload/IAP.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=1
