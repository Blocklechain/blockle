{
  "name": "@blockle/exchange-server",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial atomic-swap RELAY for exchange.blockle.org. Wallet-signature auth (EVM/Solana/BLOCK), signed swap-intent order book, price-time matching, HTLC swap state machine, and permissionless self-serve listing ($5 + $1/extra pair, mandatory BLOCK pair). Holds NO user funds, ever.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "bin": {
    "blockle-exchange": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "better-sqlite3": "^11.3.0",
    "blockle-wasm": "file:../../blockle-wasm/pkg-node",
    "bs58": "^5.0.0",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
