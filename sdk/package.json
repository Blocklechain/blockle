{
  "name": "@blockle/agent-sdk",
  "version": "0.1.0",
  "description": "TypeScript agent SDK for the Blockle L1 — wallets, transfers, BLOCK-20 token launches, native AMM pools/swaps, and the USDC buy/sell on-ramp. Signing is byte-identical to consensus (ML-DSA-44 via blockle-wasm).",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build:wasm": "cd ../blockle-wasm && wasm-pack build --target nodejs --out-dir pkg-node",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/"
  },
  "dependencies": {
    "blockle-wasm": "file:../blockle-wasm/pkg-node"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
