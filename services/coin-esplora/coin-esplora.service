[Unit]
Description=Blockle coin-esplora (public read-only REST face for the exchange coin nodes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/blockle/services/coin-esplora
ExecStart=/usr/bin/node index.js
Environment=PORT=3070
Restart=on-failure
RestartSec=10

# It reads each coin's conf for RPC credentials and talks to loopback. It has
# no business anywhere else on this host, and it holds no keys of its own.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/blockle-coins
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
