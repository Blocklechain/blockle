[Unit]
Description=Register the Blockle Intelligence Tier-2 inference subnet at activation height 18888
After=network.target blockle-node.service
Wants=blockle-node.service

[Service]
# Type=simple so `systemctl start` returns immediately while the script loops in the
# background until height >= 18888, registers once, writes its marker, and exits 0.
Type=simple
ExecStart=/usr/bin/env bash /opt/blockle/services/inference/deploy/register-tier2.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
